# City Wallet Backend - Environment Variables
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required)
OPENAI_API_KEY=your-openai-api-key-here

# Google Maps/Places API Key (required)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# OpenWeatherMap API Key (required, free tier)
OPENWEATHER_API_KEY=your-openweathermap-api-key-here

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Eventbrite API Token (for local events, optional)
EVENTBRITE_TOKEN=your-eventbrite-token-here

# Default city for demo
DEFAULT_CITY=munich
DEFAULT_LAT=48.1371
DEFAULT_LON=11.5754